# Immich endpoint used from inside the compose network.
IMMICH_URL=http://immich_server:2283
# Immich API key with asset.read, asset.view and asset.update.
IMMICH_API_KEY=change_me

# Immich Postgres (same instance, separate schema).
IMMICH_PG_HOST=immich_postgres
IMMICH_PG_PORT=5432
IMMICH_PG_DB=immich
IMMICH_PG_ADMIN_USER=postgres
IMMICH_DB_PASSWORD=change_me

# Role that owns the independent `omni` schema.
OMNI_DB_USER=omni
OMNI_DB_PASSWORD=change_me_too

# Local llama.cpp embedding server.
LLAMA_URL=http://llama-embed:8080
LLAMA_MODEL=qwen3-embedding-8b
EMBED_DIM=1024

# Remote vision model used by immich-analyze.
DESCRIBE_HOST=https://mbp-dpsk.tailc4cf9.ts.net:18081
DESCRIBE_MODEL=mlx-community/Qwen3-VL-32B-Instruct-4bit
# Tailscale node IP, pinned because Docker cannot use MagicDNS.
DESCRIBE_HOST_NAME=mbp-dpsk.tailc4cf9.ts.net
DESCRIBE_HOST_IP=100.92.101.43
ANALYZE_CONCURRENCY=4
ANALYZE_TIMEOUT=1200
THUMBNAIL_SIZE=preview

# Prompt used for description generation (Chinese, search oriented).
# DESCRIBE_PROMPT=...

# Instruction prepended to Chinese queries when embedding them.
QUERY_INSTRUCTION=给定一句中文图片搜索词，找出与描述最匹配的图片

# Proxy used only while building the pipeline image (crates.io / GitHub).
BUILD_HTTP_PROXY=http://127.0.0.1:7890
